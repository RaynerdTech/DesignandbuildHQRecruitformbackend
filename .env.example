# Set the real values in Render > Service > Environment. Do not commit .env.
NODE_ENV=production
PORT=5000
MONGODB_URI_PROD=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
RESEND_API_KEY=
RESEND_FROM_EMAIL=DesignandBuildHQ <info@designandbuildhq.com>
ADMIN_EMAIL=
CORS_ORIGIN=https://recruit.designandbuildhq.com
# Change only if you verify Render's proxy hop count is different.
TRUST_PROXY_HOPS=1
# Optional: protects GET/DELETE/PATCH admin-only routes. If unset, those
# routes refuse access; public POST /api/applications/submit still works.
ADMIN_API_KEY=
# Optional: actual admin dashboard URL (omit if you have no admin UI).
ADMIN_DASHBOARD_URL=
